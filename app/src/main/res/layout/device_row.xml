<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="76dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingHorizontal="8dp"
    android:paddingVertical="12dp" android:descendantFocusability="blocksDescendants">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="34" android:orientation="vertical"
        android:paddingHorizontal="6dp">
        <TextView android:id="@+id/name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textStyle="bold" android:textColor="@color/ink"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/device_state" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:textColor="@color/muted" />
    </LinearLayout>
    <TextView android:id="@+id/mac" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="38"
        android:paddingHorizontal="4dp" android:textSize="11sp"
        android:fontFamily="monospace" android:textColor="@color/ink"
        android:textDirection="ltr" />
    <TextView android:id="@+id/ip" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="28"
        android:textSize="12sp" android:textColor="@color/ink" android:textDirection="ltr" />
</LinearLayout>
