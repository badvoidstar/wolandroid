<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:paddingHorizontal="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="@color/ink"
        android:textSize="28sp" android:textStyle="bold" android:paddingTop="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/tagline" android:textColor="@color/muted"
        android:textSize="14sp" android:paddingBottom="8dp" />
    <Button android:id="@+id/subnet" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/select_subnet"
        android:textAllCaps="false" android:gravity="start|center_vertical"
        android:maxLines="2" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        style="?android:attr/buttonBarStyle" android:orientation="horizontal">
        <Button android:id="@+id/refresh" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/refresh" android:textAllCaps="false" />
        <Button android:id="@+id/add" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/add_device" android:textAllCaps="false" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/muted"
        android:textSize="13sp" android:paddingVertical="4dp"
        android:accessibilityLiveRegion="polite" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:visibility="invisible" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingVertical="10dp"
        android:paddingHorizontal="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="34" android:text="@string/device_name"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="38" android:text="@string/mac_address"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="28" android:text="@string/ip_address"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/ink" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <ListView android:id="@+id/devices" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@color/surface"
            android:divider="@color/divider" android:dividerHeight="1dp"
            android:scrollbars="vertical" android:fastScrollEnabled="true"
            android:overScrollMode="ifContentScrolls" android:clipToPadding="false" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:padding="24dp" android:text="@string/empty"
            android:textSize="16sp" android:textColor="@color/muted" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:gravity="center" android:text="@string/gestures"
        android:textSize="12sp" android:textColor="@color/muted" />
    <Button android:id="@+id/help" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/help"
        android:textAllCaps="false" style="?android:attr/borderlessButtonStyle" />
</LinearLayout>
